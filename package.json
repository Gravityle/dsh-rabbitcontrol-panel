{
  "name": "dsh-rabbitcontrol-panel",
  "version": "0.1.2",
  "type": "module",
  "description": "RabbitControl server console for DeepSeek Harness: sign in to an rc-server deployment, read its health, device list and relay sessions from a sidebar panel, and let the agent use read-only rc_health, rc_devices and rc_sessions tools.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "rabbitcontrol",
    "rc-server",
    "admin-console"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gravityle/dsh-rabbitcontrol-panel.git"
  }
}
